# ── References Directory ──────────────────────────────────────────────────────
# Path to your local references folder containing PDFs
REFERENCES_DIR=

# ── Crossref Metadata Lookup ─────────────────────────────────────────────────
# Optional but recommended: lets Crossref contact you if API traffic has issues.
CROSSREF_MAILTO=
CROSSREF_TIMEOUT_SECONDS=8

# ── AI API (OpenAI-compatible) ────────────────────────────────────────────────
# Any OpenAI-compatible endpoint: OpenAI, a local Ollama (http://localhost:11434/v1),
# or the managed TarCite endpoint. Leave AI_API_KEY blank for keyless/local setups.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── HuggingFace offline mode ──────────────────────────────────────────────────
# Set to 1 to skip network version-checks when models are already cached locally.
HF_HUB_OFFLINE=0

# ── Server (optional) ─────────────────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
# Hostname shown in the UI / used for local HTTPS (e.g. tarcite.workspace).
APP_DISPLAY_HOST=127.0.0.1

# ── MCP server (optional) ─────────────────────────────────────────────────────
# Expose the local library as MCP tools at /mcp. Enabled by default.
# Set to 0/false/no/off to disable the HTTP MCP endpoint.
MCP_ENABLED=1
